{
  "name": "@snailycad/ui",
  "type": "module",
  "version": "1.80.2",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "watch": "pnpm tsup --watch --silent=false",
    "typecheck": "pnpm tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --webpack-stats-json",
    "chromatic": "pnpm chromatic",
    "prepublish": "pnpm build",
    "test:e2e": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on http-get://127.0.0.1:6006 -v && pnpm test-storybook\""
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-links": "^10.2.16",
    "@storybook/addon-themes": "^10.2.16",
    "@storybook/jest": "^0.2.3",
    "@storybook/react": "^10.2.16",
    "@storybook/react-vite": "^10.2.16",
    "@storybook/test-runner": "^0.24.2",
    "autoprefixer": "^10.4.27",
    "monaco-editor": "^0.44.0",
    "postcss": "^8.5.8",
    "prop-types": "^15.8.1",
    "storybook": "^10.2.16",
    "tailwindcss": "^3.4.4",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.2.13",
    "@storybook/addon-docs": "^10.2.16"
  },
  "tsup": {
    "entry": [
      "src/index.tsx",
      "src/**/*.tsx",
      "src/**/*.ts",
      "!src/**/*.stories.tsx",
      "!src/stories/**/*"
    ],
    "bundle": false,
    "dts": true,
    "platform": "node",
    "target": "node20",
    "silent": true,
    "treeshake": true,
    "format": [
      "esm"
    ]
  },
  "dependencies": {
    "next-intl": "2.22.1",
    "use-intl": "2.22.1",
    "@casperiv/useful": "^3.0.0",
    "@internationalized/date": "^3.12.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-aria/breadcrumbs": "^3.5.32",
    "@react-aria/button": "^3.14.5",
    "@react-aria/calendar": "^3.9.5",
    "@react-aria/checkbox": "^3.16.5",
    "@react-aria/combobox": "^3.15.0",
    "@react-aria/datepicker": "^3.16.1",
    "@react-aria/dialog": "^3.5.34",
    "@react-aria/focus": "^3.21.5",
    "@react-aria/i18n": "^3.12.16",
    "@react-aria/interactions": "^3.27.1",
    "@react-aria/label": "^3.7.25",
    "@react-aria/listbox": "^3.15.3",
    "@react-aria/menu": "^3.21.0",
    "@react-aria/overlays": "^3.31.2",
    "@react-aria/progress": "^3.4.30",
    "@react-aria/radio": "^3.12.5",
    "@react-aria/switch": "^3.7.11",
    "@react-aria/textfield": "^3.18.5",
    "@react-aria/utils": "^3.33.1",
    "@react-aria/visually-hidden": "^3.8.31",
    "@react-stately/calendar": "^3.9.3",
    "@react-stately/collections": "^3.12.10",
    "@react-stately/combobox": "^3.13.0",
    "@react-stately/data": "^3.15.2",
    "@react-stately/datepicker": "^3.16.1",
    "@react-stately/list": "^3.13.4",
    "@react-stately/menu": "^3.9.11",
    "@react-stately/overlays": "^3.6.23",
    "@react-stately/radio": "^3.11.5",
    "@react-stately/select": "^3.9.2",
    "@react-stately/toggle": "^3.9.5",
    "@react-types/combobox": "^3.14.0",
    "@react-types/overlays": "^3.9.4",
    "@react-types/select": "^3.12.2",
    "@react-types/shared": "^3.33.1",
    "@snailycad/config": "workspace:*",
    "@snailycad/types": "workspace:*",
    "@snailycad/utils": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "formik": "^2.4.9",
    "mxcn": "^2.0.0",
