    "rimraf": "^6.1.3",
    "tailwind-merge": "^2.3.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "date-fns": ">=2.30.0",
    "next": "*",
    "next-intl": "2.22.1",
    "react": ">=19",
    "react-dom": ">=19",
    "use-intl": "2.22.1"
  },
  "sideEffects": false
}
